{
  "manifest_version": 3,
  "name": "NotMonk",
  "version": "1.1.0",
  "description": "Öğrenme konularını, kaynaklarını ve notlarını tek yerde takip et.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_settings_overrides": {
    "search_provider": {
      "name": "NotMonk",
      "keyword": "nm",
      "search_url": "chrome-extension://__MSG_@@extension_id__/index.html?q={searchTerms}",
      "favicon_url": "chrome-extension://__MSG_@@extension_id__/assets/icon-32.png",
      "is_default": false,
      "encoding": "UTF-8"
    }
  },
  "action": {
    "default_title": "NotMonk",
    "default_popup": "index.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "commands": {
    "open_notmonk": {
      "suggested_key": {
        "default": "Alt+N",
        "mac": "Alt+N"
      },
      "description": "NotMonk uygulamasını aç"
    }
  }
}
